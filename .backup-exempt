# Regenerable artifacts that may be deleted WITHOUT asking.
#
# Everything in this repository is otherwise covered by: nothing is ever deleted —
# displaced files go to BACKUP/<date>/ with a MANIFEST entry, and removing anything
# not matching a pattern below still needs asking first.
#
# The test for "may it go here" is: can this be regenerated exactly, from files that
# remain, by running a command? If not, it is not an artifact and it belongs in BACKUP.

# Python bytecode and tooling caches
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Build products
build/
dist/
*.egg-info/

# Test and scratch output directories — regenerated by `python -m shipdoc --out <dir>`
output_degraded/
output_*/
data_*/
.venv/

# NOT exempt, listed here so nobody assumes otherwise:
#   output/            the current run's artifacts — regenerable, but it is the
#                      deliverable; ask before removing it
#   config/unlocode.csv.gz   reference data, took a download, needed the moment the
#                      port-resolution flag flips
#   BACKUP/            the archive itself
