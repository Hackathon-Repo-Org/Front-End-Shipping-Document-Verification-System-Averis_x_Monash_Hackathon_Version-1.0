# Copy to .env and fill in. .env is gitignored and MUST NOT be committed.
# Nothing in this repository reads a key from config or from a file other than the
# environment — these names are the only channel.

# --- Hosted LLM (Phase 12). Only the one matching llm.provider is read. ---
# config/pipeline.yaml -> llm.provider: deepseek | openai | together | groq
#                                     | ollama (offline, no key) | none
DEEPSEEK_API_KEY=sk-replace-me
# OPENAI_API_KEY=sk-replace-me
# TOGETHER_API_KEY=replace-me
# GROQ_API_KEY=gsk_replace-me

# --- Database (Phase 13). Optional: with this unset the system runs exactly as
# --- before and writes files only. ---
# Azure Database for PostgreSQL Flexible Server requires SSL.
# DATABASE_URL=postgresql+psycopg://user:password@host.postgres.database.azure.com:5432/shipdoc?sslmode=require

# --- Azure Blob Storage for attachment bytes (optional). Without it, seeding
# --- records attachment metadata and skips the upload. ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=shipdoc-attachments
