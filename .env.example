# The address of the ShipDoc backend API. REQUIRED: the app has no hardcoded address.
# Copy this file to .env.local and adjust. The value is built into the website at build time.

# Local development, backend running on your own computer:
VITE_API_BASE_URL=http://localhost:8000

# Live deployment (the website and the API share one address):
# VITE_API_BASE_URL=https://shipdoc.duckdns.org
